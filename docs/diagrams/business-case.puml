@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam defaultFontColor #172B42
skinparam ArrowColor #486278
skinparam ArrowThickness 1.4
skinparam TitleFontSize 23
skinparam TitleFontColor #162A41
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #7591A5
skinparam ActivityDiamondBackgroundColor #FFF2B3
skinparam ActivityDiamondBorderColor #A38426
skinparam ActivityStartColor #285D66
skinparam ActivityEndColor #285D66
skinparam SwimlaneTitleBackgroundColor #E3EDF2
skinparam SwimlaneTitleFontSize 16
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #BDCDD6
skinparam NoteBackgroundColor #FFF8D9
skinparam NoteBorderColor #CCB76A
title Проверка стратегии на исторических данных

|#F7FAFC|ИИ-помощник|
|#F4F9F7|Участник|
|#F7FAFC|Песочница Т-Инвестиций|
|Участник|
start
if (Какой режим?) then (Тренировка)
  :Выбрать готовую ситуацию\nили описать свои условия;
  |Песочница Т-Инвестиций|
  :Открыть выбранный эпизод\nили найти подходящий в базе (RAG);
  |ИИ-помощник|
  :При необходимости составить\nпортфель по описанию;
else (Соревнование)
  |Участник|
  :Выбрать уровень сложности\nи готовый кейс\nв каталоге соревнований;
  |Песочница Т-Инвестиций|
  :Загрузить одинаковые для участников\nпериод, портфель, цель, ограничения\nи правила подсказок;
endif
|Песочница Т-Инвестиций|
:Загрузить котировки из T-Invest API\nи публикации выбранного периода;
repeat
  :Показать котировки и публикации,\nдоступные на момент шага;
  |ИИ-помощник|
  :Дать совет по раскрытым фактам,\nесли это разрешено правилами кейса;
  |Участник|
  :Подать заявку вручную или через\nвнешнего робота (T-Invest MCP)\nлибо пропустить шаг;
  |Песочница Т-Инвестиций|
  :Исполнить заявки по правилам сессии,\nзаписать сделки и обновить портфель;
repeat while (Остались события?) is (Да) not (Нет)
:Рассчитать доходность и просадку,\nпроверить выполнение цели;
if (Соревнование?) then (Да)
  :Определить место по правилам\nзачёта этой версии кейса;
else (Нет)
endif
|ИИ-помощник|
:Разобрать решения по журналу сделок,\nсобытиям и рассчитанным показателям;
|Участник|
:Изучить результат и разбор;
stop
@enduml
